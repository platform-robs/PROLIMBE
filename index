<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Prolimbe - Distribuidor oficial de productos de limpieza SWIPE.">
  <title>Prolimbe | Productos de limpieza SWIPE</title>
  <link rel="stylesheet" href="css/main.css">
  <link rel="stylesheet" href="css/responsive.css">
</head>
<body>
  <div id="site-header"></div>

  <main>
    <section id="hero" class="hero" aria-label="Promociones">
      <div id="promotion-carousel" class="carousel"></div>
    </section>

    <section class="catalog-section container" id="catalogo">
      <div class="section-heading">
        <span class="eyebrow">Catálogo</span>
        <h1>Productos de limpieza</h1>
        <p>Encuentra soluciones para hogar, negocio e industria.</p>
      </div>

      <div id="category-menu" class="category-grid"></div>

      <div class="catalog-toolbar">
        <label class="search-box">
          <span class="sr-only">Buscar productos</span>
          <input id="product-search" type="search" placeholder="Buscar productos...">
        </label>
        <select id="product-sort" aria-label="Ordenar productos">
          <option value="relevance">Más relevantes</option>
          <option value="price-asc">Precio menor</option>
          <option value="price-desc">Precio mayor</option>
          <option value="name">Nombre</option>
        </select>
      </div>

      <div id="product-grid" class="product-grid"></div>
      <div id="catalog-empty" class="empty-state hidden">
        No encontramos productos con esos criterios.
      </div>
    </section>

    <section id="faq" class="faq-section container">
      <div class="section-heading">
        <span class="eyebrow">Ayuda</span>
        <h2>Preguntas frecuentes</h2>
      </div>
      <div id="faq-list" class="faq-list"></div>
    </section>

    <section id="contacto" class="contact-section">
      <div class="container contact-card">
        <div>
          <span class="eyebrow">Contáctanos</span>
          <h2>¿Tienes alguna pregunta?</h2>
          <p>Escríbenos para conocer productos, disponibilidad, pedidos o servicios.</p>
        </div>
        <div class="contact-actions">
          <button id="whatsapp-button" class="btn btn-primary">WhatsApp</button>
          <button id="email-button" class="btn btn-secondary">Enviar correo</button>
        </div>
      </div>
    </section>
  </main>

  <div id="site-footer"></div>

  <div id="modal-root"></div>

  <script type="module" src="js/app.js"></script>
</body>
</html>
